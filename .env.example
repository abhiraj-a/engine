# ==============================================================================
# Engine Environment Variables (Template for Neon PostgreSQL)
# ==============================================================================

# Neon R2DBC URL (Direct connection recommended, with sslMode=require)
R2BC_URL=r2dbc:postgresql://ep-your-endpoint-id.us-east-2.aws.neon.tech:5432/neondb?sslMode=require
R2BC_USERNAME=neondb_owner
R2BC_PASSWORD=your_neon_password_here

# Engine Gateway Cluster Topology
ENGINE_CLUSTER_NODES=standalone

# Frontend Application Origin
FRONTEND_URL=http://localhost:5173

# Gateway Port
SERVER_PORT=8080
